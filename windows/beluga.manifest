<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into beluga.exe (see meson.build). activeCodePage UTF-8 makes the
  C runtime's narrow file functions (fopen, opendir, stat, ...) take UTF-8
  paths, exactly as on Linux and macOS, instead of the legacy ANSI code page:
  without it, any file or folder name outside that code page couldn't be
  opened. Honoured from Windows 10 version 1903 on.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Beluga.Editor" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 / 11 -->
    </application>
  </compatibility>
</assembly>
